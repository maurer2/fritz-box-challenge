{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["__mocks__/**", "index.html", "public/**", "dist/**", "**/*.gen.ts"],
  "singleAttributePerLine": true,
  "singleQuote": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/*", "react-dom", "react-dom/*"],
      },
      {
        "groupName": "tanStack",
        "elementNamePattern": ["@tanstack", "@tanstack/*"],
      },
    ],
    "groups": [
      "react",
      {
        "newlinesBetween": false,
      },
      "tanStack",
      {
        "newlinesBetween": false,
      },
      ["builtin", "external"],
      ["subpath", "internal", "parent"],
      ["sibling"],
      ["index"],
      "unknown",
    ],
    "newlinesBetween": true,
  },
  "sortPackageJson": {
    "sortScripts": true,
  },
}
